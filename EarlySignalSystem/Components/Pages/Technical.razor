@page "/technical"
@rendermode InteractiveServer
@implements IDisposable
@using EarlySignalSystem.Data
@using EarlySignalSystem.Models
@using EarlySignalSystem.Services
@using Microsoft.EntityFrameworkCore
@using Hangfire
@using EarlySignalSystem.Extensions
@inject IDbContextFactory<AppDbContext> DbContextFactory
@inject IBackgroundJobClient BackgroundJobs
@inject ISnackbar Snackbar

<PageTitle>Technical Dashboard</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudStack Spacing="0" Class="mb-6">
        <MudText Typo="Typo.h4" Style="font-weight:700;">Technical Dashboard</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">System monitoring and scan history</MudText>
    </MudStack>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else
    {
        <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-2">Pipeline Stages</MudText>
        <MudGrid Spacing="2" Class="mb-2">
            @for (var stageIndex = 0; stageIndex < _stages.Count; stageIndex++)
            {
                var stage = _stages[stageIndex];

                @if (ArrowBeforeStageIndex.Contains(stageIndex))
                {
                    <MudItem xs="12" Class="d-flex justify-center pa-0">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Class="mud-text-secondary" Size="Size.Small" />
                    </MudItem>
                }

                <MudItem xs="12" sm="@(stage.Cards.Count == 1 ? 6 : 12)">
                    <MudCard Style="background:#1a1d2e; height:100%;">
                        <MudCardHeader Class="pb-0 pt-2">
                            <CardHeaderContent>
                                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@stage.Name</MudText>
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@stage.Description</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="pt-2">
                            <MudGrid Spacing="1">
                                @foreach (var card in stage.Cards)
                                {
                                    <MudItem xs="12" sm="6" md="@(stage.Cards.Count == 1 ? 12 : 3)">
                                        <MudPaper Style="@($"background:#20243a; border-left:3px solid {GetCanalBorderColor(card)}; height:100%; padding:8px 12px;")">
                                            <MudStack Spacing="1">
                                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Spacing="1">
                                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                                        <MudText Typo="Typo.body2" Style="font-weight:700;">@card.DisplayName</MudText>
                                                        <MudTooltip Text="@card.Description" Arrow="true" Placement="Placement.Top">
                                                            <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mud-text-secondary" />
                                                        </MudTooltip>
                                                    </MudStack>
                                                    <MudChip T="string" Color="@GetCanalStatusColor(card)" Variant="Variant.Filled" Size="Size.Small" Class="ma-0">@GetCanalStatusLabel(card)</MudChip>
                                                </MudStack>

                                                @if (card.IsDisabled)
                                                {
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Disabled</MudText>
                                                }
                                                else if (card.LatestRun is null)
                                                {
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">No runs yet</MudText>
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@card.MetricLabel: @card.LatestRun.SignalsCollected · @GetDurationLabel(card.LatestRun)</MudText>
                                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@card.LatestRun.StartedAt.ToLocalDisplay(CompactDateTimeFormat)</MudText>
                                                }

                                                @if (!card.IsDisabled && card.JobKey is not null)
                                                {
                                                    // justTriggered дава мигновена обратна връзка веднага след клика (преди
                                                    // следващия auto-refresh тик); backendRunning следва реалния статус от
                                                    // RunLog-а, опресняван на всеки RefreshInterval — бутонът се самодезактивира
                                                    // отново при следващ Run/Completed цикъл.
                                                    var justTriggered = _triggeredJobs.Contains(card.JobKey);
                                                    var backendRunning = card.LatestRun?.Status == "Running";
                                                    var isRunning = justTriggered || backendRunning;
                                                    <MudButton Variant="Variant.Outlined"
                                                               Color="@(isRunning ? Color.Success : Color.Primary)"
                                                               Size="Size.Small"
                                                               FullWidth="true"
                                                               Disabled="isRunning"
                                                               StartIcon="@(isRunning ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.PlayArrow)"
                                                               OnClick="() => RunJobNowAsync(card.JobKey)">
                                                        @(backendRunning ? "Running..." : justTriggered ? "Started" : "Run now")
                                                    </MudButton>
                                                }
                                            </MudStack>
                                        </MudPaper>
                                    </MudItem>
                                }
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>

        <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-3">Last Scan Summary</MudText>
        <MudGrid Class="mb-6">
            <MudItem xs="12" sm="6" md="3">
                <MudCard Style="background:#1a1d2e; height:100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Total signals collected</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight:700;">@_totalSignalsToday</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Style="background:#1a1d2e; height:100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Companies analyzed</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight:700;">@_companiesAnalyzedToday</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Style="background:#1a1d2e; height:100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Shortlist size</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight:700;">@_shortlistSize</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudCard Style="background:#1a1d2e; height:100%;">
                    <MudCardContent>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Last scan</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:700;">@(_lastScanTimestamp?.ToLocalDisplay() ?? "—")</MudText>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>

        <MudText Typo="Typo.h5" Style="font-weight:600;" Class="mb-3">Scan History · Last 30 days</MudText>
        @if (_scanHistoryRows.Count == 0)
        {
            <MudAlert Severity="Severity.Info">No scan history yet.</MudAlert>
        }
        else
        {
            <MudTable Items="@_scanHistoryRows" Hover="true" Dense="true" Style="background:#1a1d2e;">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>EUR-Lex</MudTh>
                    <MudTh>TED</MudTh>
                    <MudTh>SEC EDGAR</MudTh>
                    <MudTh>AI Analyzer</MudTh>
                    <MudTh>Companies</MudTh>
                    <MudTh>Status</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Date">@context.Date.ToString("dd MMM yyyy")</MudTd>
                    @* context.Date вече е локална дата — виж LoadScanHistoryAsync, групирано по ToLocalDate() *@
                    <MudTd DataLabel="EUR-Lex">@FormatSignalCount(context.EurLexSignals)</MudTd>
                    <MudTd DataLabel="TED">@FormatSignalCount(context.TedSignals)</MudTd>
                    <MudTd DataLabel="SEC EDGAR">@FormatSignalCount(context.SecEdgarSignals)</MudTd>
                    <MudTd DataLabel="AI Analyzer">@FormatSignalCount(context.AiAnalyzerSignals)</MudTd>
                    <MudTd DataLabel="Companies">@context.Companies</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="@GetHistoryStatusColor(context.Status)" Variant="Variant.Filled" Size="Size.Small">@context.Status</MudChip>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</MudContainer>

@code {
    private const string NeutralBorderColor = "#374151";
    private const string CompactDateTimeFormat = "dd.MM HH:mm";
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(5);
    // Stages 2-5 (AI Analysis, Ticker Resolution, Scoring & Shortlisting, Enrichment) имат само по 1 job
    // всяка, затова се показват по две sm=6 на визуален ред (виж markup-а: MudItem sm е 6, когато
    // stage.Cards.Count == 1): ред 1 = Stage 2+3, ред 2 = Stage 4+5. Стрелка се показва само пред индекс 1
    // (влизане в реда на Stage 2+3, след пълноширочния Stage 1) и пред индекс 3 (влизане в реда на Stage 4+5).
    private static readonly HashSet<int> ArrowBeforeStageIndex = [1, 3];

    private bool _loading = true;
    private readonly HashSet<string> _triggeredJobs = [];
    // Кога е натиснат "Run now" за всеки jobKey — пази оптимистичния "Running" статус верен, докато
    // auto-refresh-ът не потвърди, че РЕАЛНО НОВ run (стартирал СЛЕД клика) е завършил. Без click-time
    // проверката, оптимистичният флаг би могъл да се изчисти от стар "Completed" RunLog, който още не
    // е бил заменен от новия run (race между клика и Hangfire-worker-a, който го пикапва).
    private readonly Dictionary<string, DateTime> _triggeredAt = new();
    private readonly CancellationTokenSource _refreshCts = new();
    private List<CanalCard> _canalCards = [];
    private List<CanalStage> _stages = [];
    private int _totalSignalsToday;
    private int _companiesAnalyzedToday;
    private int _shortlistSize;
    private DateTime? _lastScanTimestamp;
    private List<ScanHistoryRow> _scanHistoryRows = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadPipelineDataAsync();
        _loading = false;
        _ = RefreshLoopAsync(_refreshCts.Token);
    }

    // Опреснява pipeline-а на всеки RefreshInterval, докато потребителят е на страницата — без това,
    // job-ове по-надолу във веригата, които вече реално са Running, продължават да показват старото си
    // last-known състояние (напр. "Completed" от вчера) до ръчен reload, което изглежда подвеждащо.
    private async Task RefreshLoopAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(RefreshInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                await LoadPipelineDataAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Компонентът е disposed (потребителят е напуснал страницата) — нормално спиране.
        }
    }

    public void Dispose()
    {
        _refreshCts.Cancel();
        _refreshCts.Dispose();
    }

    private async Task LoadPipelineDataAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        var today = DateTime.UtcNow.Date;

        var latestRunLogs = new Dictionary<string, RunLog?>();
        foreach (var jobName in new[] { "EUR-Lex", "EP-Parliament", "SEC-EDGAR", "SEC-EDGAR-13DG", "TED", "OECD", "AMF-France", "AI-Analyzer", "Cumulative-Scorer", "Technical-Assessor", "Ticker-Verifier" })
        {
            latestRunLogs[jobName] = await dbContext.RunLogs
                .Where(r => r.JobName == jobName)
                .OrderByDescending(r => r.StartedAt)
                .FirstOrDefaultAsync();
        }

        var eurLexCard = new CanalCard("EUR-Lex", "Signals collected", latestRunLogs["EUR-Lex"], false,
            "Reads the EU's Official Journal for new laws and regulations. The idea: new legislation often affects specific companies before the market reacts in their price.", "eur-lex");
        var epParliamentCard = new CanalCard("EU Parliament", "Signals collected", latestRunLogs["EP-Parliament"], false,
            "Tracks draft committee reports and opinions — months before the law is finally adopted and published in EUR-Lex. The earliest signal in the system for upcoming legislation.", "ep-parliament");
        var secEdgarCard = new CanalCard("SEC EDGAR Form 4", "Signals collected", latestRunLogs["SEC-EDGAR"], false,
            "Tracks when directors or major owners buy shares of their own company (\"insider buying\"). People inside the company buy when they believe it will grow.", "sec-edgar");
        var secEdgar13DGCard = new CanalCard("SEC EDGAR 13D/13G", "Signals collected", latestRunLogs["SEC-EDGAR-13DG"], false,
            "Tracks when an investor acquires more than 5% of a company's shares (13D/13G filings). A large investor building a stake often sees something the market hasn't noticed yet.", "sec-edgar-13dg");
        var tedCard = new CanalCard("TED", "Signals collected", latestRunLogs["TED"], false,
            "Tracks EU public procurement. A company that wins a large government contract usually gets secured revenue for years ahead — an early growth indicator.", "ted");
        var oecdCard = new CanalCard("OECD", "Signals collected", latestRunLogs["OECD"], false,
            "Tracks the OECD's monthly Composite Leading Indicator by country — fires a signal when the index crosses the 100 threshold (a turn in the economic cycle, 4-8 months before it shows up in real data).", "oecd");
        var amfCard = new CanalCard("AMF (France)", "Signals collected", latestRunLogs["AMF-France"], false,
            "Tracks the French market regulator's (AMF) short-selling register — ESMA moved its own register behind a CAPTCHA, so we switched to France's national regulator, which publishes the same type of data freely (scope is now limited to FR-listed companies).", "amf");
        var aiAnalyzerCard = new CanalCard("AI Analyzer", "Signals analyzed", latestRunLogs["AI-Analyzer"], false,
            "Takes all collected signals and asks AI (Claude) which real public companies look promising based on them.", "ai-analyzer");
        var cumulativeScorerCard = new CanalCard("Cumulative Scorer", "Companies scored", latestRunLogs["Cumulative-Scorer"], false,
            "Aggregates all signals per company into one overall result (Score) and decides which companies make the top-5 list (shortlist).", "cumulative-scorer");
        var technicalAssessorCard = new CanalCard("Technical Assessor", "Companies assessed", latestRunLogs["Technical-Assessor"], false,
            "Takes the top-5 shortlist companies and assesses whether their price looks overbought or oversold — a technical, not fundamental, indicator.", "technical-assessor");
        var tickerVerifierCard = new CanalCard("Ticker Verifier", "Tickers verified", latestRunLogs["Ticker-Verifier"], false,
            "Looks up the real stock ticker for each newly-discovered company — first for free in the SEC registry, then Alpha Vantage — so prices and charts can be shown.", "ticker-verifier");

        // Редът тук отразява РЕАЛНАТА verига от Program.cs /api/scan-now (ContinueJobWith) — IsQueuedBehindEarlierStage
        // разчита на този ред, за да познае кои job-ове вече би трябвало да са минали в текущата вълна.
        // Ticker Verifier е ПРЕДИ Cumulative Scorer нарочно (виж коментара в Program.cs).
        _canalCards =
        [
            eurLexCard, epParliamentCard, secEdgarCard, secEdgar13DGCard, tedCard, oecdCard, amfCard,
            aiAnalyzerCard, tickerVerifierCard, cumulativeScorerCard, technicalAssessorCard,
        ];

        // Изчистваме оптимистичния "Running" флаг само след като auto-refresh-ът потвърди РЕАЛЕН нов run
        // (стартирал СЛЕД клика), стигнал терминален статус — иначе флагът увисва завинаги (LatestRun си
        // остава последният Completed/Failed запис и никога не минава синхронно през "Running" в UI, ако
        // Hangfire worker-ът все още не е пикапнал job-а към момента на този refresh tick).
        foreach (var jobKey in _triggeredJobs.ToList())
        {
            var card = _canalCards.FirstOrDefault(c => c.JobKey == jobKey);
            if (card?.LatestRun is { } run &&
                _triggeredAt.TryGetValue(jobKey, out var triggeredAt) &&
                run.StartedAt >= triggeredAt &&
                run.Status is "Completed" or "Failed")
            {
                _triggeredJobs.Remove(jobKey);
                _triggeredAt.Remove(jobKey);
            }
        }

        _stages =
        [
            new CanalStage("1 · Signal Collection", "Independent sources scanning for raw signals — legislation, insider trades, procurement contracts, macro indicators, and short-interest data.",
                [eurLexCard, epParliamentCard, secEdgarCard, secEdgar13DGCard, tedCard, oecdCard, amfCard]),
            new CanalStage("2 · AI Analysis", "Claude reviews all collected signals and identifies real, publicly-traded companies with a concrete rationale.",
                [aiAnalyzerCard]),
            new CanalStage("3 · Ticker Resolution", "Looks up the real stock ticker for every newly-discovered company — runs before scoring so today's new companies get a price, not just tomorrow's.",
                [tickerVerifierCard]),
            new CanalStage("4 · Scoring & Shortlisting", "Aggregates signals per company into a score and decides which companies make the top-5 shortlist.",
                [cumulativeScorerCard]),
            new CanalStage("5 · Enrichment", "Assesses whether the shortlisted companies' price looks overbought or oversold — a technical, not fundamental, indicator.",
                [technicalAssessorCard]),
        ];

        _totalSignalsToday = await dbContext.RunLogs
            .Where(r => r.StartedAt >= today && r.StartedAt < today.AddDays(1)
                && r.JobName != null && new[] { "EUR-Lex", "EP-Parliament", "SEC-EDGAR", "TED", "OECD", "AMF-France" }.Contains(r.JobName))
            .SumAsync(r => (int?)r.SignalsCollected) ?? 0;

        _companiesAnalyzedToday = latestRunLogs["Cumulative-Scorer"]?.SignalsCollected ?? 0;

        var latestScanKey = await dbContext.ShortlistSnapshots
            .OrderByDescending(s => s.ScanDate)
            .ThenByDescending(s => s.ScanNumber)
            .Select(s => new { s.ScanDate, s.ScanNumber })
            .FirstOrDefaultAsync();

        if (latestScanKey is not null)
        {
            _shortlistSize = await dbContext.ShortlistSnapshots
                .CountAsync(s => s.ScanDate == latestScanKey.ScanDate && s.ScanNumber == latestScanKey.ScanNumber);

            _lastScanTimestamp = await dbContext.ShortlistSnapshots
                .Where(s => s.ScanDate == latestScanKey.ScanDate && s.ScanNumber == latestScanKey.ScanNumber)
                .MaxAsync(s => (DateTime?)s.CreatedAt);
        }

        await LoadScanHistoryAsync(dbContext, today);
    }

    private async Task LoadScanHistoryAsync(AppDbContext dbContext, DateTime today)
    {
        var windowStart = today.AddDays(-29);

        var runLogs = await dbContext.RunLogs
            .Where(r => r.StartedAt >= windowStart && r.JobName != null)
            .ToListAsync();

        var picks = await dbContext.CompanyPicks
            .Where(p => p.PickedAt >= windowStart)
            .Select(p => new { p.Ticker, p.CompanyName, p.PickedAt })
            .ToListAsync();

        // Групираме по локална дата (не UTC) — event близо до полунощ трябва да падне в деня, в
        // който потребителят реално го е видял, не в UTC деня.
        var dates = runLogs.Select(r => r.StartedAt.ToLocalDate())
            .Concat(picks.Select(p => p.PickedAt.ToLocalDate()))
            .Distinct()
            .OrderByDescending(d => d)
            .ToList();

        var rows = new List<ScanHistoryRow>();
        foreach (var date in dates)
        {
            var dayRuns = runLogs.Where(r => r.StartedAt.ToLocalDate() == date).ToList();

            var eurLexSignals = GetSignalsForJob(dayRuns, "EUR-Lex");
            var tedSignals = GetSignalsForJob(dayRuns, "TED");
            var secEdgarSignals = GetSignalsForJob(dayRuns, "SEC-EDGAR");
            var aiAnalyzerSignals = GetSignalsForJob(dayRuns, "AI-Analyzer");

            if (eurLexSignals is null && tedSignals is null && secEdgarSignals is null && aiAnalyzerSignals is null)
            {
                continue;
            }

            var companies = picks.Where(p => p.PickedAt.ToLocalDate() == date)
                .Select(p => new { p.Ticker, p.CompanyName })
                .Distinct()
                .Count();

            rows.Add(new ScanHistoryRow(
                date,
                eurLexSignals,
                tedSignals,
                secEdgarSignals,
                aiAnalyzerSignals,
                companies,
                GetScanStatus(dayRuns)));
        }

        _scanHistoryRows = rows;
    }

    private static readonly string[] ImportantJobs = ["EUR-Lex", "TED", "SEC-EDGAR", "AI-Analyzer"];
    private static readonly string[] WarningOnlyJobs = [];

    private static string GetScanStatus(List<RunLog> dayRuns)
    {
        if (dayRuns.Count == 0)
        {
            return "No runs";
        }

        if (dayRuns.Any(r => ImportantJobs.Contains(r.JobName) && r.Status == "Failed"))
        {
            return "Failed";
        }

        if (dayRuns.Any(r => WarningOnlyJobs.Contains(r.JobName) && r.Status == "Failed"))
        {
            return "Warning";
        }

        return "Success";
    }

    private static int? GetSignalsForJob(List<RunLog> dayRuns, string jobName)
    {
        var jobRuns = dayRuns.Where(r => r.JobName == jobName).ToList();
        return jobRuns.Count == 0 ? null : jobRuns.Sum(r => r.SignalsCollected);
    }

    private static string FormatSignalCount(int? count) => count?.ToString() ?? "–";

    // Всеки job се пуска изолирано, извън Scan Now веригата — само enqueue-ва конкретния job,
    // без ScanGate семафора (той пази само пълната верига от едновременно пускане два пъти).
    private void RunJobNowAsync(string jobKey)
    {
        switch (jobKey)
        {
            case "eur-lex":
                BackgroundJobs.Enqueue<IDataCollectorService>(s => s.CollectEurLexSignalsAsync(CancellationToken.None));
                break;
            case "ep-parliament":
                BackgroundJobs.Enqueue<IDataCollectorService>(s => s.CollectEpParliamentSignalsAsync(CancellationToken.None));
                break;
            case "sec-edgar":
                BackgroundJobs.Enqueue<IDataCollectorService>(s => s.CollectSecEdgarSignalsAsync(CancellationToken.None));
                break;
            case "sec-edgar-13dg":
                BackgroundJobs.Enqueue<IDataCollectorService>(s => s.CollectSecEdgar13DGSignalsAsync(CancellationToken.None));
                break;
            case "ted":
                BackgroundJobs.Enqueue<IDataCollectorService>(s => s.CollectTedSignalsAsync(CancellationToken.None));
                break;
            case "oecd":
                BackgroundJobs.Enqueue<IDataCollectorService>(s => s.CollectOecdSignalsAsync(CancellationToken.None));
                break;
            case "amf":
                BackgroundJobs.Enqueue<IDataCollectorService>(s => s.CollectAmfSignalsAsync(CancellationToken.None));
                break;
            case "ai-analyzer":
                BackgroundJobs.Enqueue<IAiAnalyzerService>(s => s.AnalyzeSignalsAsync(CancellationToken.None));
                break;
            case "cumulative-scorer":
                BackgroundJobs.Enqueue<ICumulativeScoringService>(s => s.CalculateScoresAsync(CancellationToken.None));
                break;
            case "technical-assessor":
                BackgroundJobs.Enqueue<IOverboughtOversoldService>(s => s.AssessTopCompaniesAsync(CancellationToken.None));
                break;
            case "ticker-verifier":
                BackgroundJobs.Enqueue<ITickerVerificationService>(s => s.VerifyPendingTickersAsync(CancellationToken.None));
                break;
            default:
                return;
        }

        _triggeredJobs.Add(jobKey);
        _triggeredAt[jobKey] = DateTime.UtcNow;
        Snackbar.Add($"{jobKey} started", Severity.Success);
    }

    // Card-ите се зареждат веднъж в OnInitializedAsync — без live polling, статусът остава замразен
    // на last-known стойност. Когато потребителят натисне "Run now" в текущата сесия, _triggeredJobs
    // override-ва статуса оптимистично на "Running", докато страницата не се презареди с истински данни.
    private bool IsOptimisticallyRunning(CanalCard card) => card.JobKey is not null && _triggeredJobs.Contains(card.JobKey);

    // Scan Now веригата е строго последователна (ContinueJobWith, виж Program.cs) — всеки job чака
    // предходния да приключи. Но всеки card тук показва последния запис в RunLog-а за съответния job,
    // независимо от кога е бил — ако job-ът по-надолу във веригата все още не е стартирал в ТЕКУЩИЯ scan,
    // картата му ще покаже стар "Completed" от вчерашния run, което изглежда сякаш всичко тече паралелно.
    // За да го различим: ако някой по-ранен job във веригата в момента е Running, или е стартирал
    // по-late от последния run на този job, значи веригата вече е задминала този job, но той още не
    // е стигнал своя ред в тази вълна — показваме "Queued" вместо подвеждащото старо състояние.
    private bool IsQueuedBehindEarlierStage(CanalCard card)
    {
        if (card.IsDisabled || IsOptimisticallyRunning(card))
        {
            return false;
        }

        var index = _canalCards.IndexOf(card);
        var thisStarted = card.LatestRun?.StartedAt;

        for (var i = 0; i < index; i++)
        {
            var earlierRun = _canalCards[i].LatestRun;
            if (earlierRun is null)
            {
                continue;
            }

            if (earlierRun.Status == "Running" || thisStarted is null || earlierRun.StartedAt > thisStarted)
            {
                return true;
            }
        }

        return false;
    }

    private string GetCanalBorderColor(CanalCard card)
    {
        if (card.IsDisabled)
        {
            return NeutralBorderColor;
        }

        if (IsOptimisticallyRunning(card))
        {
            return EarlySignalTheme.ColorWarning;
        }

        if (IsQueuedBehindEarlierStage(card))
        {
            return NeutralBorderColor;
        }

        return card.LatestRun?.Status switch
        {
            "Completed" => EarlySignalTheme.ColorSuccess,
            "Failed" => EarlySignalTheme.ColorDanger,
            "Running" => EarlySignalTheme.ColorWarning,
            _ => NeutralBorderColor,
        };
    }

    private Color GetCanalStatusColor(CanalCard card)
    {
        if (card.IsDisabled)
        {
            return Color.Default;
        }

        if (IsOptimisticallyRunning(card))
        {
            return Color.Warning;
        }

        if (IsQueuedBehindEarlierStage(card))
        {
            return Color.Default;
        }

        return card.LatestRun?.Status switch
        {
            "Completed" => Color.Success,
            "Failed" => Color.Error,
            "Running" => Color.Warning,
            _ => Color.Default,
        };
    }

    private string GetCanalStatusLabel(CanalCard card)
    {
        if (card.IsDisabled)
        {
            return "Disabled";
        }

        if (IsQueuedBehindEarlierStage(card))
        {
            return "Queued";
        }

        if (IsOptimisticallyRunning(card))
        {
            return "Running";
        }

        return card.LatestRun?.Status ?? "No runs yet";
    }

    private static string GetDurationLabel(RunLog run)
    {
        if (run.CompletedAt is null)
        {
            return "—";
        }

        var duration = run.CompletedAt.Value - run.StartedAt;
        return duration.TotalSeconds < 60 ? $"{duration.TotalSeconds:0.0}s" : $"{duration.TotalMinutes:0.0}m";
    }

    private static Color GetHistoryStatusColor(string status) => status switch
    {
        "Success" => Color.Success,
        "Warning" => Color.Warning,
        "Failed" => Color.Error,
        _ => Color.Default,
    };

    private sealed record CanalCard(string DisplayName, string MetricLabel, RunLog? LatestRun, bool IsDisabled, string Description, string? JobKey = null);

    private sealed record CanalStage(string Name, string Description, List<CanalCard> Cards);

    private sealed record ScanHistoryRow(DateTime Date, int? EurLexSignals, int? TedSignals, int? SecEdgarSignals, int? AiAnalyzerSignals, int Companies, string Status);
}
