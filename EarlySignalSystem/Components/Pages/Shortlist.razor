@page "/shortlist"
@rendermode InteractiveServer
@using EarlySignalSystem.Data
@using EarlySignalSystem.Models
@using EarlySignalSystem.Extensions
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbContextFactory

<PageTitle>Investment Shortlist</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-6">
        <MudStack Spacing="0">
            <MudText Typo="Typo.h4" Style="font-weight:700;">Investment Shortlist</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Top companies by cumulative signal strength · Last 14 days</MudText>
        </MudStack>
        @if (_lastCalculatedAt is not null)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">Last calculated: @_lastCalculatedAt.Value.ToLocalDisplay()</MudText>
        }
    </MudStack>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
    }
    else if (_entries.Count == 0)
    {
        <MudAlert Severity="Severity.Info">Shortlist is being calculated. Check back after 19:00.</MudAlert>
    }
    else
    {
        @for (var i = 0; i < _entries.Count; i++)
        {
            var rank = i + 1;
            var entry = _entries[i];
            <MudCard Class="mb-6" Style="background:#1a1d2e;">
                <MudCardContent>
                    <MudStack Row="true" Spacing="4" AlignItems="AlignItems.Start">
                        <MudText Typo="Typo.h3" Style="font-weight:700; min-width:3.5rem;" Class="mud-text-secondary">#@rank</MudText>
                        <MudStack Spacing="1" Class="flex-grow-1">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center">
                                    <MudText Typo="Typo.h5" Style="font-weight:700;">@entry.Score.CompanyName</MudText>
                                    @if (!string.IsNullOrWhiteSpace(entry.Score.Ticker))
                                    {
                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">Ticker: @entry.Score.Ticker</MudChip>
                                    }
                                    else if (entry.TickerGivenUp)
                                    {
                                        <MudTooltip Text="Опитахме SEC, Alpha Vantage и OpenFIGI — никой не потвърди тикър за тази компания.">
                                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">No ticker found</MudChip>
                                        </MudTooltip>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(entry.Score.Sector))
                                    {
                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@entry.Score.Sector</MudChip>
                                    }
                                </MudStack>
                                <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                                    @if (!string.IsNullOrWhiteSpace(entry.LatestSentiment))
                                    {
                                        <MudChip T="string" Color="@GetSentimentColor(entry.LatestSentiment)" Variant="Variant.Filled" Size="Size.Small">@GetSentimentLabel(entry.LatestSentiment)</MudChip>
                                    }
                                    @if (entry.Assessment is not null)
                                    {
                                        <MudTooltip Text="@entry.Assessment.Reason">
                                            <MudChip T="string" Color="@GetAssessmentColor(entry.Assessment.Assessment)" Variant="Variant.Filled" Size="Size.Small">@GetAssessmentLabel(entry.Assessment.Assessment)</MudChip>
                                        </MudTooltip>
                                    }
                                    @if (entry.Score.LateDetectionFlag)
                                    {
                                        <MudTooltip Text="@($"{entry.Score.LateDetectionReason} — the market may already be reacting to this signal, which reduces the edge of picking it now.")">
                                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">⏱ Late detection</MudChip>
                                        </MudTooltip>
                                    }
                                    <MudText Typo="Typo.h4" Style="font-weight:700;" Color="@GetScoreColor(entry.Score.Score)">@entry.Score.Score.ToString("0.0")</MudText>
                                </MudStack>
                            </MudStack>

                            <MudStack Row="true" Spacing="1" Class="mt-2">
                                <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Color="Color.Default">@entry.Score.SignalCount signals</MudChip>
                                <MudTooltip Text="@GetSourceTypesTooltip(entry)" Arrow="true">
                                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Color="@GetDiversityColor(entry.Score.SignalDiversity)">@GetDiversityLabel(entry.Score.SignalDiversity)</MudChip>
                                </MudTooltip>
                                <MudTooltip Text="@VelocityTooltip" Arrow="true">
                                    <MudChip T="string" Variant="Variant.Filled" Size="Size.Small" Color="@GetVelocityColor(entry.Score.VelocityLevel)">@GetVelocityLabel(entry.Score.VelocityLevel)</MudChip>
                                </MudTooltip>
                            </MudStack>

                            @if (entry.Score.FirstSignalDate is not null)
                            {
                                // Нови компании нямат още верифицирана цена (тикърът или се верифицира, или
                                // Alpha Vantage квотата е изчерпана) — вместо да крием целия блок, показваме
                                // датите винаги и падаме към First signal стойностите за Latest, ако Latest липсва.
                                var latestDate = entry.Score.LatestPriceDate ?? entry.Score.FirstSignalDate;
                                var latestPrice = entry.Score.LatestPrice ?? entry.Score.PriceOnFirstSignalDate;

                                <MudStack Spacing="0" Class="mt-3">
                                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                        <b>First signal:</b> @entry.Score.FirstSignalDate?.ToLocalDisplay("dd MMM yyyy")
                                        @if (entry.Score.PriceOnFirstSignalDate is not null)
                                        {
                                            @:@@ $@entry.Score.PriceOnFirstSignalDate?.ToString("F2")
                                        }
                                    </MudText>
                                    <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Baseline">
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                            <b>Latest signal:</b> @latestDate?.ToLocalDisplay("dd MMM yyyy")
                                            @if (latestPrice is not null)
                                            {
                                                @:@@ @latestPrice?.ToString("F2") $
                                            }
                                        </MudText>
                                        @if (entry.Score.PriceChangePercent is not null)
                                        {
                                            <MudText Typo="Typo.h6" Style="font-weight:700;" Color="@GetPriceChangeColor(entry.Score.PriceChangePercent.Value)">
                                                @GetPriceChangeArrow(entry.Score.PriceChangePercent.Value) @entry.Score.PriceChangePercent.Value.ToString("0.0")%
                                            </MudText>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(entry.Score.Ticker) && latestPrice is null)
                                        {
                                            <MudTooltip Text="This ticker is verified but neither price source has recent trading data for it — the company may have been delisted, acquired, or gone private.">
                                                <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">⚠ No live price</MudChip>
                                            </MudTooltip>
                                        }
                                    </MudStack>
                                </MudStack>
                            }

                            @if (!string.IsNullOrWhiteSpace(entry.LatestRationale))
                            {
                                <MudText Typo="Typo.body2" Class="mt-3">@entry.LatestRationale</MudText>
                            }

                            <MudButton Variant="Variant.Text"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       Class="mt-2"
                                       Style="align-self:flex-start;"
                                       OnClick="() => ToggleExpand(entry.Score.Id)">
                                @(IsExpanded(entry.Score.Id) ? "Hide signals" : "View all signals")
                            </MudButton>

                            @if (IsExpanded(entry.Score.Id))
                            {
                                <MudStack Spacing="1" Class="mt-2">
                                    @if (entry.Signals.Count == 0)
                                    {
                                        <MudText Typo="Typo.body2" Class="mud-text-secondary">No signals found for the last 14 days.</MudText>
                                    }
                                    else
                                    {
                                        @foreach (var signal in entry.Signals)
                                        {
                                            <MudText Typo="Typo.body2">
                                                <strong>[@signal.SignalType]</strong> @signal.Title — @signal.PublishedAt.ToLocalDisplay("dd MMM yyyy")
                                            </MudText>
                                        }
                                    }
                                </MudStack>
                            }
                        </MudStack>
                    </MudStack>
                </MudCardContent>
            </MudCard>
        }
    }
</MudContainer>

@code {
    private bool _loading = true;
    private DateTime? _lastCalculatedAt;
    private List<ShortlistEntry> _entries = [];
    private readonly HashSet<int> _expandedIds = [];

    protected override async Task OnInitializedAsync()
    {
        await using var dbContext = await DbContextFactory.CreateDbContextAsync();

        var windowStart = DateTime.UtcNow.AddDays(-14);

        var topScores = await dbContext.CumulativeScores
            .OrderByDescending(s => s.Score)
            .Take(5)
            .ToListAsync();

        _lastCalculatedAt = topScores.Count > 0 ? topScores.Max(s => s.LastCalculatedAt) : null;

        var entries = new List<ShortlistEntry>();
        foreach (var score in topScores)
        {
            // CompanyPick.Ticker е замразена снимка от момента на създаване (обикновено null — виж
            // CumulativeScoringService за пълния контекст), затова филтрираме само по CompanyName,
            // не по Ticker, за да не пропуснем picks на компании с вече верифициран тикър.
            var picks = await dbContext.CompanyPicks
                .Where(p => p.CompanyName == score.CompanyName && p.PickedAt >= windowStart)
                .OrderByDescending(p => p.PickedAt)
                .ToListAsync();

            var latestRationale = picks.FirstOrDefault()?.Rationale;
            var latestSentiment = picks.FirstOrDefault()?.Sentiment;

            var assessment = await dbContext.TechnicalAssessments
                .Where(t => t.Ticker == score.Ticker)
                .OrderByDescending(t => t.AssessedAt)
                .FirstOrDefaultAsync();

            var pickIds = picks.Select(p => p.Id).ToList();
            var signalIds = pickIds.Count == 0
                ? new List<int>()
                : await dbContext.CompanyPickSignals
                    .Where(cps => pickIds.Contains(cps.CompanyPickId))
                    .Select(cps => cps.SignalId)
                    .Distinct()
                    .ToListAsync();

            var signals = signalIds.Count == 0
                ? new List<Signal>()
                : await dbContext.Signals
                    .Where(s => signalIds.Contains(s.Id))
                    .OrderByDescending(s => s.PublishedAt)
                    .ToListAsync();

            // Company.Ticker е null и в двата случая — "още не е опитано" и "опитахме всичко, нищо
            // не се потвърди" — TickerVerified различава двете, за да не показваме "No ticker found"
            // преждевременно на компании, чийто ред просто още не е дошъл в опашката.
            var tickerGivenUp = string.IsNullOrWhiteSpace(score.Ticker) && await dbContext.Companies
                .Where(c => c.CompanyName == score.CompanyName)
                .Select(c => c.TickerVerified)
                .FirstOrDefaultAsync();

            entries.Add(new ShortlistEntry(score, latestRationale, latestSentiment, signals, assessment, tickerGivenUp));
        }

        _entries = entries;
        _loading = false;
    }

    private bool IsExpanded(int scoreId) => _expandedIds.Contains(scoreId);

    private void ToggleExpand(int scoreId)
    {
        if (!_expandedIds.Add(scoreId))
        {
            _expandedIds.Remove(scoreId);
        }
    }

    private static Color GetScoreColor(decimal score) => score switch
    {
        >= 70 => Color.Success,
        >= 40 => Color.Warning,
        _ => Color.Error,
    };

    private static Color GetVelocityColor(VelocityLevel level) => level switch
    {
        VelocityLevel.High => Color.Error,
        VelocityLevel.Medium => Color.Warning,
        _ => Color.Default,
    };

    private static string GetVelocityLabel(VelocityLevel level) => level switch
    {
        VelocityLevel.High => "🔥 High velocity",
        VelocityLevel.Medium => "⚡ Medium velocity",
        _ => "· Low velocity",
    };

    private const string VelocityTooltip = "Колко бързо се трупат нови сигнали за компанията: 🔥 High = над 3 сигнала през последните 7 дни, ⚡ Medium = 2–3, · Low = 0–1. По-висока velocity = по-скорошен и по-силен интерес.";

    private static readonly Dictionary<string, string> SignalTypeNames = new()
    {
        ["Legislation"] = "EU законодателство (EUR-Lex)",
        ["PreLegislative"] = "Draft доклад/становище (EU Parliament)",
        ["InsiderBuying"] = "Insider покупки (SEC Form 4)",
        ["GovernmentContract"] = "Обществени поръчки (TED)",
        ["ShortInterestDecline"] = "Short interest (AMF France)",
        ["MajorAcquisition"] = "Придобиване >5% (SEC 13D/13G)",
        ["CliTurningPoint"] = "Обръщане на цикъла (OECD CLI)",
    };

    private static string GetSourceTypesTooltip(ShortlistEntry entry)
    {
        var names = entry.Signals.Select(s => s.SignalType).Distinct()
            .Select(t => SignalTypeNames.TryGetValue(t, out var name) ? name : t)
            .ToList();

        return names.Count > 0
            ? $"{entry.Score.SignalDiversity}/5 типа източници: {string.Join(", ", names)}"
            : $"{entry.Score.SignalDiversity}/5 типа източници";
    }

    private static Color GetDiversityColor(int diversity) => diversity switch
    {
        >= 3 => Color.Success,
        2 => Color.Warning,
        _ => Color.Default,
    };

    private static string GetDiversityLabel(int diversity) =>
        diversity == 1 ? "● 1 source type" : $"● {diversity} source types";

    private static Color GetSentimentColor(string sentiment) => sentiment switch
    {
        "Bullish" => Color.Success,
        "Bearish" => Color.Error,
        _ => Color.Default,
    };

    private static string GetSentimentLabel(string sentiment) => sentiment switch
    {
        "Bullish" => "↑ Bullish",
        "Bearish" => "↓ Bearish",
        _ => "→ Neutral",
    };

    private static Color GetAssessmentColor(string assessment) => assessment switch
    {
        "Overbought" => Color.Error,
        "Oversold" => Color.Success,
        _ => Color.Warning,
    };

    private static string GetAssessmentLabel(string assessment) => assessment switch
    {
        "Overbought" => "🔴 Overbought",
        "Oversold" => "🟢 Oversold",
        _ => "🟡 Neutral",
    };

    private static Color GetPriceChangeColor(decimal changePercent) => changePercent switch
    {
        > 0 => Color.Success,
        < 0 => Color.Error,
        _ => Color.Default,
    };

    private static string GetPriceChangeArrow(decimal changePercent) => changePercent switch
    {
        > 0 => "▲",
        < 0 => "▼",
        _ => "·",
    };

    private sealed record ShortlistEntry(CumulativeScore Score, string? LatestRationale, string? LatestSentiment, List<Signal> Signals, TechnicalAssessment? Assessment, bool TickerGivenUp);
}
